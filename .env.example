# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase (required for auth + database) ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, bypasses RLS. Used by sync scripts.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute redirect URLs for Supabase email confirmation links.
# Set to your deployed URL in production (e.g. https://fffl.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- ESPN Fantasy Football (private league) ---
# The league is private, so the server authenticates as a logged-in member
# using the SWID + espn_s2 cookie values from a browser session.
# NEVER expose ESPN_SWID or ESPN_S2 to the browser, and never commit them.
ESPN_LEAGUE_ID=1917414897
ESPN_SEASON=2026
ESPN_SWID=
ESPN_S2=

# --- Sleeper ---
# Sleeper's public API needs no credentials. Nothing to set here.

# --- YouTube (Media section) ---
# Optional for MVP. Without it, the media service can fall back to a
# lighter-weight public method; with it, the official YouTube Data API v3
# is used. See docs/architecture.md.
YOUTUBE_API_KEY=

# --- Automatic sync (Vercel Cron) ---
# Bearer token required to call /api/sync/espn (protects it from being
# triggered by anyone who finds the URL). Must be named exactly
# CRON_SECRET — Vercel automatically sends "Authorization: Bearer
# $CRON_SECRET" on scheduled cron requests (see vercel.json) when an env
# var with this exact name is set; no extra config needed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
